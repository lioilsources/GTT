{
  "name": "metropole-web",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Metropole web client (TypeScript + Babylon.js), DUALSTACK plan client W.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "record": "tsx scripts/record.ts",
    "smoke": "tsx scripts/smoke.ts",
    "icons": "python3 scripts/icons.py"
  },
  "dependencies": {
    "@babylonjs/core": "9.35.0",
    "@bufbuild/protobuf": "2.17.0",
    "planck": "1.5.1"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "2.17.0",
    "@types/node": "24.10.1",
    "playwright": "1.65.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "yaml": "2.8.1"
  }
}
