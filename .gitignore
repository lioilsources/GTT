# devconv:start
.env
.env.*
!.env.example
*.p8
*.p12
*.jks
key.properties
.DS_Store
.claude/settings.local.json
CLAUDE.local.md
.dart_tool/
build/
.flutter-plugins
.flutter-plugins-dependencies
lib/**/secrets.dart
bin/
*.test
*.out
# devconv:end

# Metropole
run/
app/build/
*.iml

# Shared-layer outputs (DUALSTACK 5.1/5.2)
/build/
app/assets/shared/
web/public/shared/
app/lib/l10n/app_localizations*.dart
PARITY.md
.claude/worktrees/

# DEM sources stay local (plans/M5_TEREN_PRIRODA.md); only the README with download steps is tracked
content/cities/*/dem/*
!content/cities/*/dem/README.md
